{
  "name": "ping-pong-marquee",
  "version": "1.0.0",
  "type": "module",
  "description": "Smart ping-pong marquee React component with airport departure board aesthetic",
  "keywords": [
    "react",
    "marquee",
    "ping-pong",
    "scroll",
    "overflow",
    "text",
    "animation",
    "departure-board"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ruchkung/ping-pong-marquee.git"
  },
  "homepage": "https://github.com/Ruchkung/ping-pong-marquee",
  "main": "./dist/ping-pong-marquee.cjs",
  "module": "./dist/ping-pong-marquee.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/ping-pong-marquee.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/ping-pong-marquee.cjs"
      }
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vite build --mode lib",
    "lint": "eslint .",
    "preview": "vite preview",
    "prepublishOnly": "npm run build:lib"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4"
  }
}
